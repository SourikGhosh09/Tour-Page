NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5959/ghure_ashi
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@ghureashi.example
ADMIN_PASSWORD=replace-this-before-seeding
APP_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Vercel automatically provides this after a public Blob store is connected.
# BLOB_READ_WRITE_TOKEN=

# Add production payment credentials when a provider is selected.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
